# Copy to .env.local and fill in. Both values are safe to expose in the browser:
# the anon key is designed for client-side use and is gated by Row Level Security.
#
# Without these, the site still builds and every public page works. The admin
# panel and results lookup will show a clear "not configured" state instead of
# failing silently.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin, used for canonical URLs, sitemap and OG tags.
# Must be the real production origin or canonicals will be wrong.
NEXT_PUBLIC_SITE_URL=https://jodhpurnationaluniversity.co.in

# Set to true to show maintainer TODO notes on the rendered pages while working
# through outstanding content. Leave unset for anything anyone else will see.
NEXT_PUBLIC_SHOW_MAINTAINER_NOTES=false

# --- Backend (Prisma + API routes) ---

# SQLite by default: no external service, file created by `prisma migrate dev`.
# For hosting, change the provider in prisma/schema.prisma to "postgresql" and
# put your Postgres connection string here instead.
DATABASE_URL="file:./dev.db"

# Signs the session JWT. MUST be at least 32 characters and MUST be different
# in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Where uploaded documents are written. Defaults to ./var/uploads.
# MUST be outside public/ — anything under public/ is served to the world.
# On Vercel the filesystem is ephemeral, so point this at object storage
# instead (see the note at the top of src/lib/storage.ts) before launch.
UPLOAD_DIR=

# Published on the certificate verification page. Set it to an address that
# is actually monitored; see content/site.ts.
# NEXT_PUBLIC_VERIFICATION_EMAIL=
