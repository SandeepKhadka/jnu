# Copy to .env.local and fill in. Both values are safe to expose in the browser:
# the anon key is designed for client-side use and is gated by Row Level Security.
#
# Without these, the site still builds and every public page works. The admin
# panel and results lookup will show a clear "not configured" state instead of
# failing silently.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute origin, used for canonical URLs, sitemap and OG tags.
# Must be the real production origin or canonicals will be wrong.
NEXT_PUBLIC_SITE_URL=https://jodhpurnationaluniversity.co.in

# Set to true to show maintainer TODO notes on the rendered pages while working
# through outstanding content. Leave unset for anything anyone else will see.
NEXT_PUBLIC_SHOW_MAINTAINER_NOTES=false
