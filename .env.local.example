# Copy to .env.local and fill in. Every variable below is read by the code.

# Absolute origin, used for canonical URLs, sitemap and OG tags.
# Must be the real production origin or canonicals will be wrong.
NEXT_PUBLIC_SITE_URL=https://jodhpurnationaluniversity.co.in

# Set to true to show maintainer TODO notes on the rendered pages while working
# through outstanding content. Leave unset for anything anyone else will see.
NEXT_PUBLIC_SHOW_MAINTAINER_NOTES=false

# Postgres. Two URLs for the same database:
#   DATABASE_URL — the POOLED connection, used for queries. On a serverless
#                  host each function instance opens its own connections and
#                  the direct limit is reached quickly.
#   DIRECT_URL   — the UNPOOLED connection, used only by `prisma migrate`,
#                  which takes advisory locks a transaction pooler does not
#                  carry through. Against the pooled URL migrations can hang.
# On Neon the pooled host is the direct one with "-pooler" on the endpoint id.
# connect_timeout is worth setting: a free Neon compute suspends when idle and
# the first connection waits for it to wake.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Signs the session JWT. MUST be at least 32 characters and MUST be different
# in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Where uploaded bytes go, when NOT using object storage (see below).
# Leave UNSET to use the defaults (./var/uploads and ./var/media). An empty
# value is not the same as unset. Both MUST be outside public/ — anything
# under public/ is served to the world.
# UPLOAD_DIR=   applicant and counselling documents
# MEDIA_DIR=    admin-uploaded images and PDFs

# Vercel Blob. Set either of these and lib/object-store switches from local
# disk to Blob automatically — nothing else changes. Required on any host with
# an ephemeral filesystem (Vercel), where a file written to disk is gone
# minutes later and the person who uploaded it never finds out.
#
# THE STORE MUST BE CREATED WITH PRIVATE ACCESS. A public store hands out URLs
# that work for anyone holding them, and this application stores Aadhaar
# documents. Vercel fixes the access mode when the store is created and it
# cannot be changed afterwards.
#
# On Vercel, connecting the store to the project sets BLOB_STORE_ID and the
# OIDC token automatically; you do not set these by hand. Use
# BLOB_READ_WRITE_TOKEN only when running outside Vercel.
# BLOB_READ_WRITE_TOKEN=

# Only read by `npm run admin:create`, for non-interactive setup. Omit it and the
# script prompts for a password without echoing. Do not leave it set afterwards.
# ADMIN_PASSWORD=
