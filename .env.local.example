# Copy to .env.local and fill in. Every variable below is read by the code.

# Absolute origin, used for canonical URLs, sitemap and OG tags.
# Must be the real production origin or canonicals will be wrong.
NEXT_PUBLIC_SITE_URL=https://jodhpurnationaluniversity.co.in

# Set to true to show maintainer TODO notes on the rendered pages while working
# through outstanding content. Leave unset for anything anyone else will see.
NEXT_PUBLIC_SHOW_MAINTAINER_NOTES=false

# SQLite by default: no external service, file created by `prisma migrate deploy`.
# For hosting, change the provider in prisma/schema.prisma to "postgresql" and
# put your Postgres connection string here instead.
DATABASE_URL="file:./dev.db"

# Signs the session JWT. MUST be at least 32 characters and MUST be different
# in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Where files are written at runtime. Leave these UNSET to use the defaults
# (./var/uploads and ./var/media). An empty value is not the same as unset.
# Both MUST be outside public/ — anything under public/ is served to the world.
# On Vercel the filesystem is ephemeral, so point them at persistent storage
# (or object storage, see the note at the top of src/lib/storage.ts) before launch.
# UPLOAD_DIR=   applicant documents
# MEDIA_DIR=    admin-uploaded images

# Only read by `npm run admin:create`, for non-interactive setup. Omit it and the
# script prompts for a password without echoing. Do not leave it set afterwards.
# ADMIN_PASSWORD=
